# ---- Backend environment (copy to .env; never commit .env) ----
# This template is committed. Put REAL secrets only in .env (gitignored).

# Neon Postgres. Copy the connection string from the Neon dashboard.
# Either postgres:// or postgresql:// works — the app rewrites it to asyncpg
# and strips libpq-only params (sslmode/channel_binding) automatically.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname

# TLS for the DB connection. true for Neon; false for a local Postgres without TLS.
DB_SSL=true

# Linear personal API key (Linear → Settings → Security & access → Personal API keys).
# Being retired in favor of Zoho Sprints below — leave unset once the Zoho
# sync is verified; app/jobs/sync.py simply has nothing to fetch without it.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# Zoho Sprints OAuth (Self Client — create at https://api-console.zoho.com/,
# scopes: ZohoSprints.projects.READ, ZohoSprints.sprints.READ,
# ZohoSprints.items.READ, ZohoSprints.teams.READ, ZohoSprints.teamusers.READ,
# ZohoSprints.projectusers.READ, ZohoSprints.epic.READ).
# Match ZOHO_ACCOUNTS_URL / ZOHO_API_URL to your account's data center
# (.com / .eu / .in / .com.au / .jp).
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# One-time: exchange a Self Client authorization code for a refresh token
# (see Zoho's Self Client docs), then paste it here / into the secret store.
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://sprintsapi.zoho.com
ZOHO_TEAM_ID=123456
# Safety margin under Zoho's documented ~30 calls/min.
ZOHO_RATE_LIMIT_PER_MIN=28

# Bearer token the frontend sends to call the insights API. Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_AUTH_TOKEN=replace-with-a-long-random-token

# Groq API key for the narrative digest (https://console.groq.com/keys).
# Optional — if unset, the digest falls back to a deterministic templated summary.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Optional overrides:
# GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated allowed CORS origins (frontend URLs).
CORS_ORIGINS=http://localhost:3000

# development | production
ENVIRONMENT=development
